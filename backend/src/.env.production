# Production Environment Configuration
NODE_ENV=production

# Production Database (use separate production DB)
MONGO_URI=mongodb+srv://production_user:secure_password@cluster0.w63grfb.mongodb.net/stock_trading_prod?retryWrites=true&w=majority&appName=Cluster0

# Redis Configuration
REDIS_HOST=redis-cluster.internal
REDIS_PORT=6379

# Server Configuration
PORT=4000
HOST=0.0.0.0

# Production Data Sources (No synthetic data allowed)
DATA_SOURCE=upstox
DATA_QUALITY_THRESHOLD=0.95

# Upstox Production API (Required for production)
UPSTOX_API_KEY=your_production_api_key
UPSTOX_ACCESS_TOKEN=your_production_access_token
UPSTOX_API_SECRET=your_production_secret

# Security Configuration
API_RATE_LIMIT=1000
REQUEST_TIMEOUT=30000
MAX_CONCURRENT_REQUESTS=10

# Monitoring & Logging
LOG_LEVEL=info
DATA_QUALITY_LOGGING=true
AUDIT_TRAIL_ENABLED=true
HEALTH_CHECK_ENABLED=true

# Compliance Settings
DATA_RETENTION_DAYS=730
AUDIT_LOG_RETENTION_DAYS=365
COMPLIANCE_REPORTING=true